# ==============================================================================
# TravelGenie — Environment Configuration Template
# ==============================================================================
# Copy this file to server/.env for local development:
#   cp .env.example server/.env
# In Render: Set these variables in the Render Dashboard under "Environment".
# NEVER commit .env files containing real secrets, tokens, or credentials!
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development

# Server Port (Render sets this automatically in production)
PORT=5000

# JWT Authentication Secret Key (REQUIRED)
# Must be at least 32 characters long. Predictable/default values are rejected at startup.
# Generate a strong key using: openssl rand -base64 32
JWT_SECRET=your_cryptographically_secure_jwt_secret_min_32_chars_here

# Allowed Frontend Origins for CORS (REQUIRED in production)
# Comma-separated list of exact trusted origins that can make credentialed API calls.
# Note: Wildcards ('*') and insecure Render subdomains are strictly disallowed with credentials.
# In local development, localhost and 127.0.0.1 (ports 5173, 5000, 3000) are automatically included.
ALLOWED_ORIGINS=https://travelgenie.onrender.com

# PostgreSQL Database Connection String (REQUIRED in production)
# In production, strict TLS certificate verification (rejectUnauthorized: true) is enforced.
# Local development example: postgresql://postgres@127.0.0.1:5434/postgres
DATABASE_URL=postgresql://user:password@host:5432/travelgenie_db

# PostgreSQL TLS Configuration (Optional)
# In production, TLS is automatically enabled with strict certificate validation.
# DATABASE_SSL=true
# DB_CA_CERT=             # Optional: Inline PEM certificate string for custom enterprise CA
# PGSSLROOTCERT=          # Optional: Path to root CA certificate file

# Google Gemini API Key (Optional in local demo mode, REQUIRED for live AI generation)
# Obtain your key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# AI Usage Protection (Optional)
# Maximum number of plan generation/modification requests permitted per user account per hour.
AI_HOURLY_QUOTA_PER_USER=15

# Integration Test Suite AI Quota Protection (Optional)
# Set to 'true' to execute live Gemini AI calls during test_stage2_http_routes.ts.
# Requires a valid GEMINI_API_KEY. Default is 'false' to preserve AI quota.
# RUN_LIVE_AI_TESTS=true
